# ---- Auth.js (NextAuth v5) ----
# Generate a strong secret:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=09c938d9ca6b819828cf53eeb8ddaa1a823fb81c1bcbb4f32b710887fb329e18

# Google OAuth client (see README step 1)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Optional: restrict who can log in. Comma-separated emails.
# Leave empty to allow ANY Google account (current setting).
ALLOWED_EMAILS=

# In production on Cloudflare, set this to your deployed URL, e.g. https://trend-scanner.pages.dev
# For local dev it defaults to http://localhost:3000
AUTH_URL=http://localhost:3000
