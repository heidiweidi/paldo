# ---- Auth.js (NextAuth v5) ----
# Generate a strong secret:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=auth-secret

# Google OAuth client (see README step 1)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Optional: restrict who can log in. Comma-separated emails.
# Leave empty to allow ANY Google account (current setting).
ALLOWED_EMAILS=

# In production on Cloudflare, set this to your deployed URL, e.g. https://trend-scanner.pages.dev
# For local dev it defaults to http://localhost:3000
AUTH_URL=http://localhost:3000

# ---- Discord alerts (optional) ----
# Server-side default webhook. If unset, each visitor can paste their own
# in the Alerts panel instead (stored in their browser only).
DISCORD_WEBHOOK_URL=

# ---- CoinGecko top-N universe (optional) ----
# Only needed if you use "Top by market cap" instead of the curated coin list.
COINGECKO_API_KEY=

# ---- Scheduled scan: /api/cron/scan (optional) ----
# Required for that endpoint to run at all (it fails closed without it).
# Generate with: openssl rand -base64 33
# Must match the CRON_SECRET secret used by .github/workflows/scan-cron.yml.
CRON_SECRET=

# Minimum setup grade the scheduled scan alerts on: "A+", "A" (default), or "B" (everything).
ALERT_MIN_GRADE=A
