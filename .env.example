# ---- Wallet sign-in (Sign-In with Ethereum) ----
# Signs the session cookie. A random string of at least 32 characters:  openssl rand -base64 33
# Without it nobody can sign in (every page redirects to /login).
SESSION_SECRET=

# Who may enter. Comma-separated wallet addresses, e.g. 0xAbc...,0xDef...
# A lone * lets ANY wallet in. Empty lets nobody in. Removing an address revokes it immediately.
WALLET_ALLOWLIST=

# WalletConnect (QR code / mobile wallets, and Trust Wallet on desktop). Free project ID from
# https://dashboard.reown.com . Optional: without it only browser-extension / in-app wallets work.
WALLETCONNECT_PROJECT_ID=

# ---- Discord alerts (optional) ----
# Server-side default webhook. If unset, each visitor can paste their own
# in the Alerts panel instead (stored in their browser only).
DISCORD_WEBHOOK_URL=

# ---- CoinGecko top-N universe (optional) ----
# Only needed if you use "Top by market cap" instead of the curated coin list.
COINGECKO_API_KEY=

# ---- Scheduled scan: /api/cron/scan (optional) ----
# Required for that endpoint to run at all (it fails closed without it).
# Generate with: openssl rand -base64 33
# Must match the CRON_SECRET secret used by .github/workflows/scan-cron.yml.
CRON_SECRET=

# Minimum setup grade the scheduled scan alerts on: "A+", "A" (default), or "B" (everything).
ALERT_MIN_GRADE=A
